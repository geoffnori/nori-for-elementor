{
 "key": "faq",
 "label": "FAQ",
 "group": "page",
 "order": 85,
 "anchor": "faq",
 "description": "Questions customers ask, as an accordion. Also tells search engines about them (FAQ structured data).",
 "slots": {
  "eyebrow": {
   "label": "Eyebrow",
   "type": "text",
   "sample": "Questions"
  },
  "heading": {
   "label": "Heading",
   "type": "text",
   "required": true,
   "sample": "Before you call"
  },
  "intro": {
   "label": "Intro",
   "type": "textarea",
   "sample": "Still not sure? Call and ask. A real person answers."
  },
  "items": {
   "label": "Questions",
   "type": "list",
   "min": 2,
   "max": 10,
   "required": true,
   "fields": {
    "question": {
     "type": "text"
    },
    "answer": {
     "type": "textarea"
    }
   },
   "sample": [
    {
     "question": "Do you charge to come out?",
     "answer": "There's a small visit fee, which goes toward the repair if you go ahead with it."
    },
    {
     "question": "Will I know the price before you start?",
     "answer": "Yes. You get a written price for the job, and we don't start until you approve it."
    },
    {
     "question": "Which areas do you serve?",
     "answer": "List the towns and neighborhoods you cover here."
    },
    {
     "question": "Do you work nights and weekends?",
     "answer": "Say when you're available, and how to reach you in an emergency."
    }
   ]
  },
  "cta": {
   "label": "Button",
   "type": "link",
   "sample": {
    "label": "Contact us",
    "url": "/contact/"
   }
  }
 },
 "variants": {
  "studio": {
   "label": "Studio: heading and questions side by side",
   "tree": [
    {
     "el": "e-flexbox",
     "label": "FAQ",
     "children": [
      {
       "el": "e-flexbox",
       "label": "Inner",
       "children": [
        {
         "el": "e-grid",
         "label": "Columns",
         "children": [
          {
           "el": "e-flexbox",
           "label": "Heading",
           "children": [
            {
             "el": "e-paragraph",
             "text": "{eyebrow}",
             "classes": [
              "type-overline"
             ],
             "css": {
              "desktop": {
               "color": "var(muted)",
               "margin": "0px"
              }
             },
             "if": "eyebrow"
            },
            {
             "el": "e-heading",
             "text": "{heading}",
             "classes": [
              "type-h2"
             ],
             "css": {
              "desktop": {
               "color": "var(primary)"
              }
             },
             "tag": "h2"
            },
            {
             "el": "e-paragraph",
             "text": "{intro}",
             "classes": [
              "type-lead"
             ],
             "css": {
              "desktop": {
               "color": "var(muted)",
               "margin": "0px"
              }
             },
             "if": "intro"
            },
            {
             "el": "button",
             "link": "{cta}",
             "classes": [
              "btn-outline"
             ],
             "label": "Button",
             "if": "cta"
            }
           ],
           "css": {
            "desktop": {
             "padding": "0px",
             "flex-direction": "column",
             "align-items": "flex-start",
             "position": "sticky",
             "inset-block-start": "32px",
             "align-self": "start"
            },
            "mobile": {
             "position": "relative",
             "inset-block-start": "0px"
            }
           },
           "classes": [
            "gap-m"
           ]
          },
          {
           "el": "e-accordion",
           "label": "Questions",
           "settings": {
            "faq_schema": true
           },
           "css": {
            "desktop": {
             "width": "100%",
             "padding": "0px"
            }
           },
           "children": [
            {
             "each": "items",
             "as": "item",
             "node": {
              "el": "e-accordion-item",
              "label": "{item.question}",
              "classes": [
               "border-bottom"
              ],
              "css": {
               "desktop": {
                "padding": "0px"
               }
              },
              "children": [
               {
                "el": "e-accordion-item-header",
                "settings": {
                 "show_icon": true
                },
                "label": "Header",
                "css": {
                 "desktop": {
                  "padding": {
                   "block-start": "22px",
                   "block-end": "22px",
                   "inline-start": "0px",
                   "inline-end": "0px"
                  },
                  "cursor": "pointer"
                 }
                },
                "children": [
                 {
                  "el": "e-accordion-item-title",
                  "label": "Title",
                  "css": {
                   "desktop": {
                    "width": "100%",
                    "padding": "0px"
                   }
                  },
                  "children": [
                   {
                    "el": "e-paragraph",
                    "text": "{item.question}",
                    "classes": [
                     "type-h6"
                    ],
                    "css": {
                     "desktop": {
                      "color": "var(primary)",
                      "margin": "0px"
                     }
                    },
                    "tag": "span"
                   }
                  ]
                 },
                 {
                  "el": "e-accordion-item-icon",
                  "label": "Icon",
                  "children": [
                   {
                    "el": "e-svg",
                    "icon": "plus",
                    "css": {
                     "desktop": {
                      "width": "22px",
                      "height": "22px",
                      "color": "var(primary)"
                     }
                    }
                   }
                  ]
                 }
                ]
               },
               {
                "el": "e-accordion-item-content",
                "label": "Content",
                "css": {
                 "desktop": {
                  "padding": {
                   "block-start": "0px",
                   "block-end": "22px",
                   "inline-start": "0px",
                   "inline-end": "0px"
                  }
                 }
                },
                "children": [
                 {
                  "el": "e-paragraph",
                  "text": "{item.answer}",
                  "classes": [
                   "type-body"
                  ],
                  "css": {
                   "desktop": {
                    "color": "var(muted)",
                    "margin": "0px",
                    "max-width": "640px"
                   }
                  }
                 }
                ]
               }
              ]
             }
            }
           ]
          }
         ],
         "css": {
          "desktop": {
           "padding": "0px",
           "grid-template-rows": "auto",
           "grid-template-columns": "minmax(0, 0.9fr) minmax(0, 1.3fr)",
           "align-items": "start"
          },
          "mobile": {
           "grid-template-columns": "minmax(0, 1fr)"
          }
         },
         "classes": [
          "gap-xl"
         ]
        }
       ],
       "css": {
        "desktop": {
         "padding": "0px",
         "flex-direction": "column",
         "align-items": "stretch"
        }
       },
       "classes": [
        "container-max-1200",
        "gap-l",
        "scroll-anim"
       ]
      }
     ],
     "css": {
      "desktop": {
       "flex-direction": "column",
       "background": "var(background)"
      }
     },
     "classes": [
      "section-gutter",
      "section-tb-padding-xl"
     ],
     "tag": "section"
    }
   ]
  },
