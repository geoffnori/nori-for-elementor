             }
            },
            "classes": [
             "open-lightbox",
             "card-border-radius"
            ]
           },
           "fill": {
            "cols": 3,
            "mobile_cols": 2
           },
           "from": 3
          }
         ],
         "css": {
          "desktop": {
           "padding": "0px",
           "grid-template-rows": "auto",
           "grid-template-columns": "repeat(3, minmax(0, 1fr))"
          },
          "mobile": {
           "grid-template-columns": "repeat(2, minmax(0, 1fr))"
