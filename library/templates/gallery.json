           "limit": 1
          },
          {
           "each": "images",
           "as": "item",
           "node": {
            "el": "e-image",
            "image": "{item.image}",
            "label": "{item.caption}",
            "css": {
             "desktop": {
              "width": "100%",
              "object-fit": "cover",
              "height": "620px",
              "grid-column": "1 / -1"
             },
             "mobile": {
              "height": "260px"
             }
            },
            "classes": [
