             "limit": 2
            }
           ],
           "css": {
            "desktop": {
             "padding": "0px",
             "grid-template-rows": "auto",
             "grid-template-columns": "minmax(0, 1fr)"
            },
            "mobile": {
             "grid-template-columns": "repeat(2, minmax(0, 1fr))"
            }
           },
           "classes": [
            "gap-s"
           ],
           "if": "images.2"
          },
          {
           "each": "images",
           "as": "item",
           "node": {
            "el": "e-image",
            "image": "{item.image}",
            "label": "{item.caption}",
            "css": {
             "desktop": {
              "width": "100%",
              "object-fit": "cover",
              "height": "620px"
             },
             "mobile": {
              "height": "260px"
             }
            },
            "classes": [
             "open-lightbox",
             "card-border-radius"
            ],
            "unless": "images.2"
           },
           "from": 1,
           "limit": 1
          }
         ],
         "css": {
          "desktop": {
           "padding": "0px",
           "grid-template-rows": "auto",
           "grid-template-columns": "minmax(0, 1.6fr) minmax(0, 1fr)"
          },
          "mobile": {
           "grid-template-columns": "minmax(0, 1fr)"
          }
         },
         "classes": [
          "gap-s"
         ]
        },
        {
         "el": "e-grid",
         "label": "More photos",
         "children": [
          {
           "each": "images",
           "as": "item",
           "node": {
            "el": "e-image",
            "image": "{item.image}",
            "label": "{item.caption}",
            "css": {
             "desktop": {
              "width": "100%",
              "object-fit": "cover",
              "height": "300px",
              "grid-column": "{_span}"
             },
             "mobile": {
