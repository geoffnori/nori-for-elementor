          {
           "each": "items",
           "as": "item",
           "node": {
            "el": "e-flexbox",
            "label": "Review",
            "children": [
             {
              "el": "e-paragraph",
              "text": "“{item.quote}”",
              "classes": [
               "type-body"
              ],
              "css": {
               "desktop": {
                "color": "var(text)",
                "margin": "0px"
               }
              }
             },
             {
              "el": "e-paragraph",
              "text": "{item.name}",
              "classes": [
               "type-label"
              ],
              "css": {
               "desktop": {
                "color": "var(primary)",
                "margin": "0px"
               }
              }
             },
             {
              "el": "e-paragraph",
              "text": "{item.detail}",
              "classes": [
               "type-small"
              ],
              "css": {
               "desktop": {
                "color": "var(muted)",
                "margin": "0px"
               }
              },
              "if": "item.detail"
             }
            ],
            "css": {
             "desktop": {
              "padding": {
               "block-start": "24px",
               "block-end": "0px",
               "inline-start": "0px",
               "inline-end": "0px"
              },
              "flex-direction": "column",
              "align-items": "flex-start"
             }
            },
            "classes": [
             "gap-s",
             "border-top"
            ]
           },
           "from": 1,
           "limit": 3
          }
         ],
         "css": {
          "desktop": {
           "padding": "0px",
           "grid-template-rows": "auto",
           "grid-template-columns": "repeat(3, minmax(0, 1fr))"
          },
          "mobile": {
           "grid-template-columns": "minmax(0, 1fr)"
          }
         },
         "classes": [
          "gap-l"
         ],
         "if": "items.1"
        }
       ],
       "css": {
        "desktop": {
         "padding": "0px",
         "flex-direction": "column",
         "align-items": "stretch"
        }
       },
       "classes": [
        "container-max-1200",
        "gap-xl",
        "scroll-anim"
       ]
      }
     ],
     "css": {
      "desktop": {
       "flex-direction": "column",
       "background": "var(background)"
      }
     },
     "classes": [
      "section-gutter",
      "section-tb-padding-l"
     ],
     "tag": "section"
    }
   ]
