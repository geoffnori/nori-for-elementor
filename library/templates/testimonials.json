{
 "key": "testimonials",
 "label": "Testimonials",
 "group": "proof",
 "order": 60,
 "anchor": "reviews",
 "description": "Customer reviews in a three-up grid. Use real reviews, with the reviewer's permission.",
 "slots": {
  "eyebrow": {
   "label": "Eyebrow",
   "type": "text",
   "sample": "Reviews"
  },
  "heading": {
   "label": "Heading",
   "type": "text",
   "required": true,
   "sample": "What our customers say"
  },
  "rating_line": {
   "label": "Rating line",
   "type": "text",
   "help": "For example your Google rating. Real numbers only."
  },
  "items": {
   "label": "Reviews",
   "type": "list",
   "min": 1,
   "max": 6,
   "required": true,
   "fields": {
    "quote": {
     "type": "textarea"
    },
    "name": {
     "type": "text"
    },
    "detail": {
     "type": "text"
    }
   },
   "sample": [
    {
     "quote": "Replace this with a real review from a happy customer. Two or three sentences work best.",
     "name": "Customer name",
     "detail": "Town or service"
    },
    {
     "quote": "Replace this with a real review from a happy customer. Two or three sentences work best.",
     "name": "Customer name",
     "detail": "Town or service"
    },
    {
     "quote": "Replace this with a real review from a happy customer. Two or three sentences work best.",
     "name": "Customer name",
     "detail": "Town or service"
    }
   ]
  },
  "video": {
   "label": "Video",
   "type": "video",
   "sample": "sample",
   "help": "Billboard and Lens: a short looping video (MP4, no sound needed). Studio and Bento don't use it."
  }
 },
 "variants": {
