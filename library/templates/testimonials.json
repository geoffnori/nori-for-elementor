            "gap-s",
            "scroll-anim"
           ]
          }
         ],
         "css": {
          "desktop": {
           "padding": "0px",
           "justify-content": "center"
          }
         }
        },
        {
         "el": "e-background-video-controls",
         "label": "Controls",
         "children": [
          {
           "el": "e-background-video-play",
           "label": "Play button",
           "children": [
            {
             "el": "e-paragraph",
             "text": "Play",
             "tag": "span"
            }
           ]
          },
          {
           "el": "e-background-video-pause",
           "label": "Pause button",
           "children": [
            {
             "el": "e-paragraph",
             "text": "Pause",
             "tag": "span"
            }
           ]
          }
         ],
         "css": {
          "desktop": {
           "inset-block-start": "20px",
           "inset-block-end": "auto"
          }
         }
        }
       ]
      },
      {
       "el": "e-flexbox",
       "label": "More reviews",
       "children": [
        {
         "el": "e-flexbox",
         "label": "Inner",
         "children": [
          {
           "el": "e-flexbox",
           "label": "Reviews",
           "children": [
            {
             "each": "items",
             "as": "item",
             "node": {
              "el": "e-flexbox",
              "label": "Review",
              "children": [
               {
                "el": "e-paragraph",
                "text": "“{item.quote}”",
                "classes": [
                 "type-lead"
                ],
                "css": {
                 "desktop": {
                  "color": "var(primary)",
                  "margin": "0px"
                 }
                }
               },
               {
                "el": "e-paragraph",
                "text": "{item.name}",
                "classes": [
                 "type-label"
                ],
                "css": {
                 "desktop": {
                  "color": "var(primary)",
                  "margin": "0px"
                 }
                }
               },
               {
                "el": "e-paragraph",
                "text": "{item.detail}",
                "classes": [
                 "type-small"
                ],
                "css": {
                 "desktop": {
                  "color": "var(muted)",
                  "margin": "0px"
                 }
                },
                "if": "item.detail"
               }
              ],
              "css": {
               "desktop": {
                "flex-direction": "column",
                "align-items": "flex-start",
                "background": "var(surface)",
                "flex": {
                 "flexGrow": 1,
                 "flexShrink": 1,
                 "flexBasis": "300px"
                }
               }
              },
              "classes": [
               "gap-s",
               "card-border-radius",
               "padding-m"
              ]
             },
             "from": 1,
             "limit": 3
            }
           ],
           "css": {
            "desktop": {
             "padding": "0px",
             "flex-direction": "row",
             "flex-wrap": "wrap",
             "align-items": "stretch"
            }
           },
           "classes": [
            "gap-s"
           ]
          }
         ],
         "css": {
          "desktop": {
           "padding": "0px",
           "flex-direction": "column",
           "align-items": "stretch"
          }
         },
         "classes": [
          "container-max-1400"
         ]
        }
       ],
       "css": {
        "desktop": {
         "flex-direction": "column",
         "padding": {
          "block-start": "16px",
          "block-end": "0px",
          "inline-start": "40px",
          "inline-end": "40px"
         }
        },
        "mobile": {
         "padding": {
          "block-start": "12px",
          "block-end": "0px",
          "inline-start": "18px",
          "inline-end": "18px"
         }
        }
       },
       "classes": [
        "section-gutter"
       ],
       "if": "items.1"
      }
     ],
     "css": {
      "desktop": {
       "padding": "0px",
       "flex-direction": "column",
       "background": "var(background)",
       "align-items": "stretch"
      }
     },
     "tag": "section"
    }
   ]
  }
 }
}
