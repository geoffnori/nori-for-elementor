{
 "key": "hero",
 "label": "Hero",
 "group": "page",
 "order": 20,
 "description": "The first screen: what the business does and where, with the main way to get in touch.",
 "slots": {
  "eyebrow": {
   "label": "Eyebrow",
   "type": "text",
   "sample": "Licensed plumbers · Bend, Oregon"
  },
  "headline": {
   "label": "Headline",
   "type": "text",
   "required": true,
   "sample": "Leaks, clogs and water heaters fixed the same day."
  },
  "subhead": {
   "label": "Subhead",
   "type": "textarea",
   "required": true,
   "sample": "A family-run team serving Central Oregon since 2009. Upfront prices before any work starts, and we clean up after ourselves."
  },
  "cta_primary": {
   "label": "Main button",
   "type": "link",
   "required": true,
   "sample": {
    "label": "Book a visit",
    "url": "/contact/"
   }
  },
  "cta_secondary": {
   "label": "Second button",
   "type": "link",
   "sample": {
    "label": "Call (541) 555-0148",
    "url": "tel:+15415550148"
   }
  },
  "trust_line": {
   "label": "Trust line",
   "type": "text",
   "help": "A short fact, like a rating or years in business. Only real numbers."
  },
  "image": {
   "label": "Image",
   "type": "image",
   "help": "Leave empty for a placeholder you replace in Elementor."
  },
  "badge": {
   "label": "Badge",
   "type": "text",
   "sample": "Booking visits this week",
   "help": "A short live note on the photo (Studio) or under the buttons (Bento). Leave empty to hide."
  },
  "highlight_title": {
   "label": "Highlight",
   "type": "text",
   "sample": "Same-day visits, 7 days a week",
   "help": "Bento: the accent tile next to the hero."
  },
  "highlight_text": {
   "label": "Highlight text",
   "type": "text",
   "sample": "Book before noon."
  },
  "highlight_icon": {
   "label": "Highlight icon",
   "type": "icon",
   "default": "clock",
   "sample": "clock"
  },
  "rating": {
   "label": "Rating",
   "type": "text",
   "help": "Bento: a rating tile, like 4.9. Real numbers only; leave empty to hide the tile."
  },
  "rating_label": {
   "label": "Rating label",
   "type": "text",
   "help": "Under the rating, like Google reviews."
  },
  "video": {
   "label": "Video",
   "type": "video",
   "sample": "sample",
   "help": "Billboard and Lens: a short looping video (MP4, no sound needed). Studio and Bento don't use it."
  },
  "business_name": {
   "label": "Business name",
   "type": "text",
   "help": "Billboard: shown across the full width with the video inside the letters. Filled in from the site title."
  }
 },
 "variants": {
  "studio": {
   "label": "Studio: large headline and a wide photo",
   "tree": [
    {
     "el": "e-flexbox",
     "label": "Hero",
     "children": [
      {
       "el": "e-flexbox",
       "label": "Inner",
