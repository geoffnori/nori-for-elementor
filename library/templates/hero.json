           "css": {
            "desktop": {
             "padding": "0px",
             "flex-direction": "row",
             "flex-wrap": "wrap",
             "justify-content": "flex-end",
             "align-items": "center"
            },
            "mobile": {
             "justify-content": "flex-start"
            }
           },
           "classes": [
            "gap-s"
           ]
          }
         ],
         "css": {
          "desktop": {
           "padding": "0px",
           "grid-template-rows": "auto",
           "grid-template-columns": "minmax(0, 1.1fr) minmax(0, 1fr)",
           "align-items": "end"
          },
          "mobile": {
           "grid-template-columns": "minmax(0, 1fr)"
          }
         },
         "classes": [
          "gap-l"
         ]
        },
        {
         "el": "e-flexbox",
         "label": "Photo",
         "children": [
          {
           "el": "e-image",
           "image": "{image}",
           "label": "Image",
           "css": {
            "desktop": {
             "width": "100%",
             "object-fit": "cover",
             "height": "520px"
            },
            "tablet": {
             "height": "420px"
            },
            "mobile": {
             "height": "280px",
             "border-radius": "14px"
            }
           },
           "classes": [
            "card-border-radius"
           ]
          },
          {
           "el": "e-paragraph",
           "text": "{badge}",
           "classes": [
            "type-label",
            "border-radius-pill"
           ],
           "css": {
            "desktop": {
             "color": "var(primary)",
             "margin": "0px",
             "position": "absolute",
             "inset-block-start": "18px",
             "inset-inline-end": "18px",
             "background": "var(background)",
             "padding": {
              "block-start": "10px",
              "block-end": "10px",
              "inline-start": "16px",
              "inline-end": "16px"
             }
            }
           },
           "label": "Badge",
           "if": "badge"
          }
         ],
         "css": {
          "desktop": {
           "padding": "0px",
           "flex-direction": "column",
           "position": "relative"
          }
         }
        },
        {
         "el": "e-paragraph",
         "text": "{trust_line}",
         "classes": [
          "type-small"
         ],
         "css": {
          "desktop": {
           "color": "var(muted)",
           "margin": "0px"
          }
         },
         "if": "trust_line"
        }
       ],
       "css": {
        "desktop": {
         "padding": "0px",
         "flex-direction": "column",
         "align-items": "stretch"
        }
       },
       "classes": [
        "container-max-1200",
        "gap-l",
        "scroll-anim"
       ]
      }
     ],
     "css": {
      "desktop": {
       "flex-direction": "column",
       "background": "var(background)"
      }
     },
     "classes": [
      "section-gutter",
      "section-tb-padding-m"
     ],
     "tag": "section"
    }
   ]
