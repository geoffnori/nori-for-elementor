{
 "key": "about",
 "label": "About",
 "group": "page",
 "order": 40,
 "anchor": "about",
 "description": "Your story and what makes you different, with a photo and up to four short points.",
 "slots": {
  "eyebrow": {
   "label": "Eyebrow",
   "type": "text",
   "sample": "About us"
  },
  "heading": {
   "label": "Heading",
   "type": "text",
   "required": true,
   "sample": "Two plumbers, one van, and a promise to show up on time"
  },
  "body": {
   "label": "Story",
   "type": "textarea",
   "required": true,
   "sample": "We started in 2009 after a decade at a big franchise. Today there are nine of us, but the rules haven't changed: we tell you the price first, we wear shoe covers, and we call if we're going to be late."
  },
  "points": {
   "label": "Points",
   "type": "list",
   "max": 4,
   "fields": {
    "text": {
     "type": "text"
    }
   },
   "sample": [
    {
     "text": "Licensed and insured"
    },
    {
     "text": "1-year warranty on all work"
    },
    {
     "text": "Prices before we start"
    },
    {
     "text": "Local and family owned"
    }
   ]
  },
  "image": {
   "label": "Image",
   "type": "image"
  },
  "cta": {
   "label": "Button",
   "type": "link",
   "sample": {
    "label": "Meet the team",
    "url": "/about/"
   }
  },
  "image_2": {
   "label": "Second image",
   "type": "image",
   "help": "Studio shows two photos side by side."
  }
 },
