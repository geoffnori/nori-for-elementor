  "billboard": {
   "label": "Billboard: video beside an accent block with one huge number",
   "tree": [
    {
     "el": "e-grid",
     "label": "Numbers",
     "children": [
      {
       "el": "e-background-video",
       "label": "Video",
       "video": "{video}",
       "classes": [
        "bg-video"
       ],
       "css": {
        "desktop": {
         "padding": "0px",
         "min-height": "560px"
        },
        "mobile": {
         "min-height": "300px"
        }
       },
       "children": [
        {
         "el": "e-background-video-content",
         "label": "Content",
         "children": [],
         "css": {
          "desktop": {
           "padding": "0px"
          }
         }
        },
        {
         "el": "e-background-video-controls",
         "label": "Controls",
         "children": [
          {
           "el": "e-background-video-play",
           "label": "Play button",
           "children": [
            {
             "el": "e-paragraph",
             "text": "Play",
             "tag": "span"
            }
           ]
          },
          {
           "el": "e-background-video-pause",
           "label": "Pause button",
           "children": [
            {
             "el": "e-paragraph",
             "text": "Pause",
             "tag": "span"
            }
           ]
          }
         ],
         "css": {
          "desktop": {
           "inset-block-start": "20px",
           "inset-block-end": "auto"
          }
         }
        }
       ]
      },
      {
       "el": "e-flexbox",
       "label": "Accent block",
       "children": [
        {
         "el": "e-heading",
         "text": "{heading}",
         "classes": [
          "type-h4",
          "all-caps"
         ],
         "css": {
          "desktop": {
           "color": "var(on-accent)"
