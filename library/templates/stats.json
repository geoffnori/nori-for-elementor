         },
         "if": "heading",
         "tag": "h2"
        },
        {
         "el": "e-flexbox",
         "label": "Big number",
         "children": [
          {
           "el": "e-paragraph",
           "text": "{items.0.label}",
           "classes": [
            "type-overline"
           ],
           "css": {
            "desktop": {
             "color": "var(on-accent)",
             "margin": "0px"
            }
           }
          },
          {
           "el": "e-paragraph",
           "text": "{items.0.number}",
           "classes": [
            "type-display",
            "headline-poster"
           ],
           "css": {
            "desktop": {
             "color": "var(on-accent)",
             "margin": "0px",
             "font-size": "160px"
            },
            "tablet": {
             "font-size": "120px"
            },
            "mobile": {
             "font-size": "96px"
            }
           }
          }
         ],
         "css": {
          "desktop": {
           "padding": "0px",
           "flex-direction": "column",
           "align-items": "flex-start"
          }
         },
         "classes": [
          "gap-s"
         ]
        },
        {
         "el": "e-flexbox",
         "label": "More numbers",
         "children": [
          {
           "each": "items",
           "as": "item",
           "node": {
            "el": "e-flexbox",
            "label": "Number",
            "children": [
             {
              "el": "e-paragraph",
              "text": "{item.number}",
              "classes": [
               "type-h3",
               "headline-poster"
              ],
              "css": {
               "desktop": {
                "color": "var(on-accent)",
                "margin": "0px"
               }
              }
             },
             {
              "el": "e-paragraph",
              "text": "{item.label}",
              "classes": [
               "type-small"
              ],
              "css": {
               "desktop": {
                "color": "var(on-accent)",
                "margin": "0px",
                "opacity": "80%"
               }
              }
             }
            ],
            "css": {
             "desktop": {
              "padding": {
               "block-start": "14px",
               "block-end": "0px",
               "inline-start": "0px",
               "inline-end": "0px"
              },
              "flex-direction": "column",
              "gap": "4px",
              "border-color": "var(on-accent)"
             }
            },
            "classes": [
             "border-top"
            ]
           },
           "from": 1,
           "limit": 3
          }
         ],
         "css": {
          "desktop": {
           "padding": "0px",
           "flex-direction": "column",
           "align-items": "stretch"
          }
         },
         "if": "items.1"
