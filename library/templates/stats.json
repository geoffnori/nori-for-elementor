{
 "key": "stats",
 "label": "Stats",
 "group": "proof",
 "order": 50,
 "description": "Three or four numbers on a strong band. Use only real numbers.",
 "slots": {
  "heading": {
   "label": "Heading",
   "type": "text"
  },
  "items": {
   "label": "Numbers",
   "type": "list",
   "min": 3,
   "max": 4,
   "required": true,
   "fields": {
    "number": {
     "type": "text"
    },
    "label": {
     "type": "text"
    }
   },
   "sample": [
    {
     "number": "15+",
     "label": "years in business"
    },
    {
     "number": "6,000",
     "label": "jobs completed"
    },
    {
     "number": "4.9",
     "label": "average rating"
    },
    {
     "number": "< 2 hr",
     "label": "emergency arrival"
    }
   ],
   "help": "Real numbers only. Change these before you publish."
  },
  "video": {
   "label": "Video",
   "type": "video",
   "sample": "sample",
   "help": "Billboard and Lens: a short looping video (MP4, no sound needed). Studio and Bento don't use it."
  }
 },
 "variants": {
  "studio": {
   "label": "Studio: large numbers",
   "tree": [
    {
     "el": "e-flexbox",
     "label": "Numbers",
     "children": [
      {
       "el": "e-flexbox",
       "label": "Inner",
       "children": [
        {
         "el": "e-heading",
         "text": "{heading}",
         "classes": [
          "type-h3"
         ],
         "css": {
          "desktop": {
           "color": "var(primary)"
          }
         },
         "if": "heading",
         "tag": "h2"
        },
        {
         "el": "e-grid",
         "label": "Numbers",
         "children": [
          {
           "each": "items",
           "as": "item",
           "node": {
            "el": "e-flexbox",
            "label": "Number",
            "children": [
             {
              "el": "e-paragraph",
              "text": "{item.number}",
              "classes": [
               "type-display"
              ],
              "css": {
               "desktop": {
                "color": "var(primary)",
                "margin": "0px",
                "letter-spacing": "-0.04em"
               }
              }
             },
             {
              "el": "e-paragraph",
              "text": "{item.label}",
              "classes": [
               "type-small"
              ],
              "css": {
               "desktop": {
                "color": "var(muted)",
                "margin": "0px"
               }
              }
             }
            ],
            "css": {
             "desktop": {
              "padding": {
               "block-start": "24px",
               "block-end": "0px",
               "inline-start": "0px",
               "inline-end": "0px"
              },
              "flex-direction": "column",
              "align-items": "flex-start"
             }
            },
            "classes": [
             "gap-xs",
             "border-top"
            ]
           }
          }
         ],
         "css": {
          "desktop": {
           "padding": "0px",
           "grid-template-rows": "auto",
           "grid-template-columns": "repeat({items|count}, minmax(0, 1fr))"
          },
          "mobile": {
           "grid-template-columns": "repeat(2, minmax(0, 1fr))"
          }
         },
         "classes": [
          "gap-l"
         ]
        }
       ],
       "css": {
        "desktop": {
         "padding": "0px",
         "flex-direction": "column",
         "align-items": "stretch"
        }
       },
       "classes": [
        "container-max-1200",
        "gap-l",
        "scroll-anim"
       ]
      }
     ],
     "css": {
      "desktop": {
       "flex-direction": "column",
       "background": "var(background)"
      }
     },
     "classes": [
      "section-gutter",
      "section-tb-padding-l"
     ],
     "tag": "section"
    }
   ]
  },
