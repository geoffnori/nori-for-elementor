{
 "key": "steps",
 "label": "Steps",
 "group": "page",
 "order": 45,
 "anchor": "how-it-works",
 "description": "How working with the business goes, in two to four steps.",
 "slots": {
  "eyebrow": {
   "label": "Eyebrow",
   "type": "text",
   "sample": "How a visit works"
  },
  "heading": {
   "label": "Heading",
   "type": "text",
   "required": true,
   "sample": "Fixed today, priced first"
  },
  "items": {
   "label": "Steps",
   "type": "list",
   "required": true,
   "min": 2,
   "max": 4,
   "fields": {
    "title": {
     "type": "text"
    },
    "text": {
     "type": "textarea"
    }
   },
   "sample": [
    {
     "title": "Call or book online",
     "text": "Tell us what's happening. Most calls before noon get a same-day visit."
    },
    {
     "title": "A price before we start",
     "text": "We look, explain the fix and give you a written price. No surprises."
    },
    {
     "title": "Fixed and cleaned up",
     "text": "We do the work, test it with you and leave the space as we found it."
    }
   ]
  }
 },
