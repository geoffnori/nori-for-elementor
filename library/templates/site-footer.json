{
 "key": "site-footer",
 "label": "Footer",
 "group": "site",
 "order": 90,
 "description": "Business name, a short line, menu, contact details, hours and the legal line..",
 "slots": {
  "business_name": {
   "label": "Business name",
   "type": "text",
   "required": true,
   "sample": "Alder Creek Plumbing"
  },
  "tagline": {
   "label": "Short description",
   "type": "text",
   "sample": "Family-run plumbing for Central Oregon since 2009."
  },
  "menu": {
   "label": "Menu links",
   "type": "list",
   "max": 7,
   "fields": {
    "label": {
     "type": "text"
    },
    "url": {
     "type": "url"
    }
   },
   "sample": [
    {
     "label": "Home",
     "url": "/"
    },
    {
     "label": "Services",
     "url": "/services/"
    },
    {
     "label": "About",
     "url": "/about/"
    },
    {
     "label": "Contact",
     "url": "/contact/"
    }
   ]
  },
  "phone": {
   "label": "Phone",
   "type": "text",
   "sample": "(541) 555-0148"
  },
  "email": {
   "label": "Email",
   "type": "text",
   "sample": "hello@example.com"
  },
  "address": {
   "label": "Address",
   "type": "text",
   "sample": "412 NE Pine Ave, Bend, OR"
  },
  "hours": {
   "label": "Hours",
   "type": "list",
   "max": 7,
   "fields": {
    "days": {
     "type": "text"
    },
    "time": {
     "type": "text"
    }
   },
   "sample": [
    {
     "days": "Mon–Fri",
     "time": "7am–6pm"
    },
    {
     "days": "Sat",
     "time": "8am–2pm"
    },
    {
     "days": "Sun",
     "time": "Emergencies only"
    }
   ]
  },
  "legal_line": {
   "label": "Legal line",
   "type": "text",
   "required": true,
   "sample": "© 2026 Alder Creek Plumbing LLC"
  }
 },
 "variants": {
  "studio": {
