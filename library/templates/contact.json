              "desktop": {
               "color": "var(text)",
               "margin": "0px"
              }
             },
             "link": "{email|mailto}",
             "if": "email"
            },
            {
             "el": "e-paragraph",
             "text": "{address}",
             "classes": [
              "type-lead"
             ],
             "css": {
              "desktop": {
               "color": "var(muted)",
               "margin": "0px"
              }
             },
             "if": "address"
            },
            {
             "el": "e-flexbox",
             "label": "Hours",
             "children": [
              {
               "each": "hours",
               "as": "item",
               "node": {
                "el": "e-flexbox",
                "label": "Row",
                "children": [
                 {
                  "el": "e-paragraph",
                  "text": "{item.days}",
                  "classes": [
                   "type-body"
                  ],
                  "css": {
                   "desktop": {
                    "color": "var(text)",
                    "margin": "0px"
                   }
                  }
                 },
                 {
                  "el": "e-paragraph",
                  "text": "{item.time}",
                  "classes": [
                   "type-body"
                  ],
                  "css": {
                   "desktop": {
                    "color": "var(muted)",
                    "margin": "0px"
                   }
                  }
                 }
                ],
                "css": {
                 "desktop": {
                  "padding": {
                   "block-start": "12px",
                   "block-end": "12px",
                   "inline-start": "0px",
                   "inline-end": "0px"
                  },
                  "flex-direction": "row",
                  "justify-content": "space-between"
                 }
                },
                "classes": [
                 "border-bottom",
                 "gap-s"
                ]
               }
              }
             ],
             "css": {
              "desktop": {
               "padding": "0px",
               "flex-direction": "column",
               "align-items": "stretch"
              }
             },
             "if": "hours"
            },
            {
             "el": "e-flexbox",
             "label": "Buttons",
             "children": [
              {
               "el": "button",
               "link": {
                "label": "Call us",
                "url": "{phone|tel}"
               },
               "classes": [
                "btn-primary",
                "btn-lg",
                "btn-pill"
               ],
               "label": "Call"
              },
              {
               "el": "button",
               "link": {
                "label": "Get directions",
                "url": "{map_link}"
               },
               "classes": [
                "btn-outline",
                "btn-lg",
                "btn-pill"
               ],
               "label": "Directions",
               "if": "map_link"
              }
             ],
             "css": {
              "desktop": {
               "padding": "0px",
               "flex-direction": "row",
               "flex-wrap": "wrap"
              }
             },
             "classes": [
              "gap-s"
             ]
            }
           ],
           "css": {
            "desktop": {
             "flex-direction": "column",
             "align-items": "stretch",
             "background": "var(surface)"
            },
            "mobile": {
             "padding": "26px",
             "border-radius": "22px"
            }
           },
           "classes": [
            "gap-m",
            "card-border-radius",
            "padding-l"
           ]
          },
          {
           "el": "e-image",
           "image": "{map_image}",
           "label": "Map image",
           "css": {
            "desktop": {
             "width": "100%",
             "object-fit": "cover",
             "height": "100%",
             "min-height": "520px"
            },
            "mobile": {
             "min-height": "260px",
             "border-radius": "22px"
            }
           },
           "classes": [
            "card-border-radius"
           ]
          }
         ],
         "css": {
          "desktop": {
           "padding": "0px",
           "grid-template-rows": "auto",
           "grid-template-columns": "minmax(0, 1fr) minmax(0, 1.1fr)",
           "align-items": "stretch"
          },
          "mobile": {
           "grid-template-columns": "minmax(0, 1fr)"
          }
         },
         "classes": [
          "gap-s"
         ]
        }
       ],
       "css": {
        "desktop": {
         "padding": "0px",
         "flex-direction": "column",
         "align-items": "stretch"
        }
       },
       "classes": [
        "container-max-1400",
        "gap-xl",
        "scroll-anim"
       ]
      }
     ],
     "css": {
      "desktop": {
       "flex-direction": "column",
       "background": "var(background)"
      }
     },
     "classes": [
      "section-gutter",
      "section-tb-padding-l"
     ],
     "tag": "section"
    }
   ]
  }
 }
}
