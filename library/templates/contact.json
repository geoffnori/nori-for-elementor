{
 "key": "contact",
 "label": "Contact & hours",
 "group": "page",
 "order": 95,
 "anchor": "contact",
 "description": "Phone, email, address and opening hours, with buttons to call and get directions, next to a map image.",
 "slots": {
  "eyebrow": {
   "label": "Eyebrow",
   "type": "text",
   "sample": "Get in touch"
  },
  "heading": {
   "label": "Heading",
   "type": "text",
   "required": true,
   "sample": "Call, email or stop by"
  },
  "phone": {
   "label": "Phone",
   "type": "text",
   "required": true,
   "sample": "(555) 010-0148"
  },
  "email": {
   "label": "Email",
   "type": "text",
   "sample": "hello@example.com"
  },
  "address": {
   "label": "Address",
   "type": "text",
   "sample": "123 Main Street, Your Town"
  },
  "hours": {
   "label": "Hours",
   "type": "list",
   "max": 7,
   "fields": {
    "days": {
     "type": "text"
    },
    "time": {
     "type": "text"
    }
   },
   "sample": [
    {
     "days": "Mon – Fri",
     "time": "7:00 am – 6:00 pm"
    },
    {
     "days": "Saturday",
     "time": "8:00 am – 2:00 pm"
    },
    {
     "days": "Sunday",
     "time": "Closed"
    }
   ]
  },
  "map_link": {
   "label": "Directions link",
   "type": "url",
   "help": "A Google Maps or Apple Maps link to your address."
  },
  "map_image": {
   "label": "Map image",
   "type": "image",
   "help": "A screenshot of your location on a map."
  }
 },
 "variants": {
  "studio": {
   "label": "Studio: details, hours and a map",
   "tree": [
    {
     "el": "e-flexbox",
     "label": "Contact",
     "children": [
      {
       "el": "e-flexbox",
       "label": "Inner",
       "children": [
        {
         "el": "e-grid",
         "label": "Columns",
         "children": [
          {
           "el": "e-flexbox",
           "label": "Details",
           "children": [
            {
             "el": "e-paragraph",
             "text": "{eyebrow}",
             "classes": [
              "type-overline"
             ],
             "css": {
              "desktop": {
               "color": "var(muted)",
               "margin": "0px"
              }
             },
             "if": "eyebrow"
            },
            {
             "el": "e-heading",
             "text": "{heading}",
             "classes": [
              "type-h2"
             ],
             "css": {
              "desktop": {
               "color": "var(primary)"
              }
             },
             "tag": "h2"
            },
            {
             "el": "e-flexbox",
             "label": "Lines",
             "children": [
              {
               "el": "e-paragraph",
               "text": "{phone}",
               "classes": [
                "type-h4"
               ],
               "css": {
                "desktop": {
                 "color": "var(primary)",
                 "margin": "0px",
                 "letter-spacing": "-0.02em"
                }
               },
               "link": "{phone|tel}"
              },
              {
               "el": "e-paragraph",
               "text": "{email}",
               "classes": [
                "type-lead"
               ],
               "css": {
                "desktop": {
                 "color": "var(text)",
                 "margin": "0px"
                }
               },
               "link": "{email|mailto}",
               "if": "email"
              },
              {
               "el": "e-paragraph",
               "text": "{address}",
               "classes": [
                "type-lead"
               ],
               "css": {
                "desktop": {
                 "color": "var(muted)",
                 "margin": "0px"
                }
               },
               "if": "address"
              }
             ],
             "css": {
              "desktop": {
               "padding": "0px",
               "flex-direction": "column",
               "align-items": "flex-start"
              }
             },
             "classes": [
              "gap-xs"
             ]
            },
            {
             "el": "e-grid",
             "label": "Hours",
             "children": [
              {
               "each": "hours",
               "as": "item",
               "node": {
                "el": "e-flexbox",
                "label": "Row",
                "children": [
                 {
                  "el": "e-paragraph",
                  "text": "{item.days}",
                  "classes": [
                   "type-body"
                  ],
                  "css": {
                   "desktop": {
                    "color": "var(text)",
                    "margin": "0px"
                   }
                  }
                 },
                 {
                  "el": "e-paragraph",
                  "text": "{item.time}",
                  "classes": [
                   "type-body"
                  ],
                  "css": {
                   "desktop": {
                    "color": "var(muted)",
                    "margin": "0px"
                   }
                  }
                 }
                ],
                "css": {
                 "desktop": {
                  "padding": {
                   "block-start": "12px",
                   "block-end": "12px",
                   "inline-start": "0px",
                   "inline-end": "0px"
                  },
                  "flex-direction": "row",
                  "justify-content": "space-between"
                 }
                },
                "classes": [
                 "border-bottom",
                 "gap-s"
                ]
               }
              }
             ],
             "css": {
              "desktop": {
               "padding": "0px",
               "grid-template-rows": "auto",
               "grid-template-columns": "minmax(0, 1fr)",
               "gap": "0px"
              }
             },
             "if": "hours"
            },
            {
             "el": "e-flexbox",
             "label": "Buttons",
             "children": [
              {
               "el": "button",
               "link": {
                "label": "Call us",
                "url": "{phone|tel}"
               },
               "classes": [
                "btn-secondary"
               ],
               "label": "Call"
              },
              {
               "el": "button",
               "link": {
                "label": "Get directions",
                "url": "{map_link}"
               },
               "classes": [
                "btn-outline"
               ],
               "label": "Directions",
               "if": "map_link"
              }
             ],
             "css": {
              "desktop": {
               "padding": "0px",
               "flex-direction": "row",
               "flex-wrap": "wrap"
              }
             },
             "classes": [
              "gap-s"
             ]
            }
           ],
           "css": {
            "desktop": {
             "padding": "0px",
             "flex-direction": "column",
             "align-items": "stretch"
            }
           },
           "classes": [
            "gap-m"
           ]
          },
          {
           "el": "e-image",
           "image": "{map_image}",
           "label": "Map image",
           "css": {
            "desktop": {
             "width": "100%",
             "object-fit": "cover",
             "height": "100%",
             "min-height": "480px"
            },
            "mobile": {
             "min-height": "260px"
            }
           },
           "classes": [
            "card-border-radius"
           ]
          }
         ],
         "css": {
          "desktop": {
           "padding": "0px",
           "grid-template-rows": "auto",
           "grid-template-columns": "minmax(0, 1fr) minmax(0, 1.1fr)",
           "align-items": "stretch"
          },
          "mobile": {
           "grid-template-columns": "minmax(0, 1fr)"
          }
         },
         "classes": [
          "gap-xl"
         ]
        }
       ],
       "css": {
        "desktop": {
         "padding": "0px",
         "flex-direction": "column",
         "align-items": "stretch"
        }
       },
       "classes": [
        "container-max-1200",
        "gap-l",
        "scroll-anim"
       ]
      }
     ],
     "css": {
      "desktop": {
       "flex-direction": "column",
       "background": "var(background)"
      }
     },
     "classes": [
      "section-gutter",
      "section-tb-padding-l"
     ],
     "tag": "section"
    }
   ]
  },
