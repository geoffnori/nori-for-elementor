{
 "key": "team",
 "label": "Team",
 "group": "proof",
 "order": 70,
 "anchor": "team",
 "description": "The people behind the business, with a photo, name and role each.",
 "slots": {
  "eyebrow": {
   "label": "Eyebrow",
   "type": "text",
   "sample": "The team"
  },
  "heading": {
   "label": "Heading",
   "type": "text",
   "required": true,
   "sample": "The people you'll meet"
  },
  "people": {
   "label": "People",
   "type": "list",
   "min": 2,
   "max": 8,
   "required": true,
   "fields": {
    "name": {
     "type": "text"
    },
    "role": {
     "type": "text"
    },
    "photo": {
     "type": "image"
    }
   },
   "sample": [
    {
     "name": "Team member",
     "role": "Role or title"
    },
    {
     "name": "Team member",
     "role": "Role or title"
    },
    {
     "name": "Team member",
