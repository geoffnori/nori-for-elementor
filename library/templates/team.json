 "variants": {
  "studio": {
   "label": "Studio: photo grid",
   "tree": [
    {
     "el": "e-flexbox",
     "label": "Team",
     "children": [
      {
       "el": "e-flexbox",
       "label": "Inner",
       "children": [
        {
         "el": "e-flexbox",
         "label": "Heading",
         "children": [
          {
           "el": "e-paragraph",
           "text": "{eyebrow}",
           "classes": [
            "type-overline"
           ],
           "css": {
            "desktop": {
             "color": "var(muted)",
             "margin": "0px"
            }
           },
           "if": "eyebrow"
          },
          {
           "el": "e-heading",
           "text": "{heading}",
           "classes": [
            "type-h2"
           ],
           "css": {
            "desktop": {
             "color": "var(primary)"
            }
           },
           "tag": "h2"
          }
         ],
         "css": {
          "desktop": {
           "padding": "0px",
           "flex-direction": "column",
           "align-items": "flex-start"
          }
         },
         "classes": [
          "gap-s"
         ]
        },
        {
         "el": "e-grid",
         "label": "People",
         "children": [
          {
           "each": "people",
           "as": "item",
           "node": {
            "el": "e-flexbox",
            "label": "{item.name}",
            "children": [
             {
              "el": "e-image",
              "image": "{item.photo}",
              "label": "Photo",
              "css": {
               "desktop": {
                "width": "100%",
                "object-fit": "cover",
                "height": "360px",
                "border-radius": "var(border-radius-s)"
               },
               "mobile": {
                "height": "220px"
               }
              }
             },
             {
              "el": "e-paragraph",
              "text": "{item.name}",
              "classes": [
               "type-h6"
              ],
              "css": {
               "desktop": {
                "color": "var(primary)",
                "margin": "0px"
               }
              }
             },
             {
              "el": "e-paragraph",
              "text": "{item.role}",
              "classes": [
               "type-small"
              ],
              "css": {
               "desktop": {
                "color": "var(muted)",
                "margin": "0px"
               }
              }
             }
            ],
            "css": {
             "desktop": {
              "padding": "0px",
              "flex-direction": "column",
              "align-items": "stretch"
             }
            },
            "classes": [
             "gap-xs"
            ]
           }
          }
         ],
         "css": {
          "desktop": {
           "padding": "0px",
           "grid-template-rows": "auto",
           "grid-template-columns": "repeat(4, minmax(0, 1fr))"
          },
          "tablet": {
           "grid-template-columns": "repeat(3, minmax(0, 1fr))"
          },
          "mobile": {
           "grid-template-columns": "repeat(2, minmax(0, 1fr))"
          }
         },
         "classes": [
          "gap-m"
         ]
        }
       ],
       "css": {
        "desktop": {
         "padding": "0px",
         "flex-direction": "column",
         "align-items": "stretch"
        }
       },
       "classes": [
        "container-max-1200",
        "gap-l",
        "scroll-anim"
       ]
      }
     ],
     "css": {
      "desktop": {
       "flex-direction": "column",
       "background": "var(background)"
      }
     },
     "classes": [
      "section-gutter",
      "section-tb-padding-l"
     ],
     "tag": "section"
    }
   ]
