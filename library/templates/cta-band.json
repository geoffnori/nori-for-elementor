{
 "key": "cta-band",
 "label": "Call to action",
 "group": "page",
 "order": 88,
 "description": "A short push near the end of a page: one line and one or two buttons.",
 "slots": {
  "heading": {
   "label": "Heading",
   "type": "text",
   "required": true,
   "sample": "Got a leak right now?"
  },
  "text": {
   "label": "Text",
   "type": "text",
   "sample": "We usually have someone free today."
  },
  "cta_primary": {
   "label": "Main button",
   "type": "link",
   "required": true,
   "sample": {
    "label": "Book a visit",
    "url": "/contact/"
   }
  },
  "cta_secondary": {
   "label": "Second button",
   "type": "link",
   "sample": {
    "label": "Call us",
    "url": "/contact/"
   }
  },
  "video": {
   "label": "Video",
   "type": "video",
   "sample": "sample",
   "help": "Billboard and Lens: a short looping video (MP4, no sound needed). Studio and Bento don't use it."
  }
 },
 "variants": {
  "studio": {
   "label": "Studio: full-width band with large type",
   "tree": [
    {
     "el": "e-flexbox",
     "label": "Call to action",
     "children": [
      {
       "el": "e-flexbox",
       "label": "Inner",
       "children": [
        {
         "el": "e-grid",
         "label": "Row",
         "children": [
          {
           "el": "e-heading",
           "text": "{heading}",
           "classes": [
            "type-display"
           ],
           "css": {
            "desktop": {
             "color": "var(on-band)",
             "letter-spacing": "-0.04em",
             "max-width": "900px"
            }
           },
           "tag": "h2"
          },
          {
           "el": "e-flexbox",
           "label": "Buttons",
           "children": [
            {
             "el": "e-paragraph",
             "text": "{text}",
             "classes": [
              "type-lead"
             ],
             "css": {
              "desktop": {
               "color": "var(on-band)",
               "margin": "0px",
               "opacity": "75%"
              }
             },
             "if": "text"
            },
            {
             "el": "e-flexbox",
             "label": "Buttons row",
             "children": [
              {
               "el": "button",
               "link": "{cta_primary}",
               "classes": [
                "btn-primary",
                "btn-lg"
               ],
               "label": "Main button",
               "icon": "arrow-right"
              },
              {
               "el": "button",
               "link": "{cta_secondary}",
               "classes": [
                "btn-outline",
                "btn-lg"
               ],
               "label": "Second button",
               "css": {
                "desktop": {
                 "border-color": "var(on-band)",
                 "color": "var(on-band)"
                }
               },
               "if": "cta_secondary"
              }
             ],
             "css": {
              "desktop": {
               "padding": "0px",
               "flex-direction": "row",
               "flex-wrap": "wrap"
              }
             },
             "classes": [
              "gap-s"
             ]
            }
           ],
           "css": {
            "desktop": {
             "padding": "0px",
             "flex-direction": "column",
             "align-items": "flex-start"
            }
           },
           "classes": [
            "gap-m"
           ]
          }
         ],
         "css": {
          "desktop": {
           "padding": "0px",
           "grid-template-rows": "auto",
           "grid-template-columns": "minmax(0, 1.4fr) minmax(0, 1fr)",
           "align-items": "end"
          },
          "mobile": {
           "grid-template-columns": "minmax(0, 1fr)"
          }
         },
         "classes": [
          "gap-xl"
         ]
        }
       ],
       "css": {
        "desktop": {
         "padding": "0px",
         "flex-direction": "column",
         "align-items": "stretch"
        }
       },
       "classes": [
        "container-max-1200",
        "scroll-anim"
       ]
      }
     ],
     "css": {
      "desktop": {
       "flex-direction": "column",
       "background": "var(band)"
      }
     },
     "classes": [
      "section-gutter",
      "section-tb-padding-xl"
     ],
     "tag": "section"
    }
   ]
  },
