{
 "key": "services",
 "label": "Services",
 "group": "page",
 "order": 30,
 "anchor": "services",
 "description": "What the business offers, 3 to 9 items with an icon, a title and a short line each.",
 "slots": {
  "eyebrow": {
   "label": "Eyebrow",
   "type": "text",
   "sample": "What we do"
  },
  "heading": {
   "label": "Heading",
   "type": "text",
   "required": true,
   "sample": "Plumbing services for homes and small businesses"
  },
  "intro": {
   "label": "Intro",
   "type": "textarea"
  },
  "items": {
   "label": "Services",
   "type": "list",
   "min": 3,
   "max": 9,
   "required": true,
   "fields": {
    "icon": {
     "type": "icon",
     "default": "check"
    },
    "title": {
     "type": "text"
    },
    "text": {
     "type": "textarea"
    }
   },
   "sample": [
    {
     "icon": "drop",
     "title": "Leak repair",
     "text": "Dripping taps to burst pipes. We find the source, not just the puddle."
    },
    {
     "icon": "flame",
     "title": "Water heaters",
     "text": "Repair and replacement for tank and tankless models, usually within a day."
    },
    {
     "icon": "wrench",
     "title": "Drain cleaning",
     "text": "Kitchen, bath and main lines cleared, with a camera check when it keeps coming back."
    },
    {
     "icon": "pipe",
     "title": "Repiping",
     "text": "Old galvanized lines swapped for PEX, with drywall patched when we're done."
    },
    {
     "icon": "clock",
     "title": "Emergency calls",
     "text": "A plumber on call nights and weekends for anything that can't wait."
    },
    {
     "icon": "shield",
     "title": "Inspections",
     "text": "Pre-purchase and annual checkups with a written report and photos."
    }
   ],
   "help": "Icons: see the icon list"
  },
  "cta": {
   "label": "Button (list variant)",
   "type": "link",
   "sample": {
    "label": "Call us",
    "url": "/contact/"
   }
  },
  "image": {
   "label": "Image",
   "type": "image",
   "help": "The photo for the first service (Bento) or none (Studio)."
  },
  "note_title": {
   "label": "Note",
   "type": "text",
   "sample": "Not sure what you need?",
   "help": "Bento: an accent tile with the button. Leave empty to hide."
  },
  "note_text": {
   "label": "Note text",
   "type": "text",
   "sample": "Call and describe the problem. We'll tell you if it needs a visit."
  }
 },
 "variants": {
  "studio": {
   "label": "Studio: a list with arrows",
   "tree": [
    {
     "el": "e-flexbox",
     "label": "Services",
     "children": [
      {
       "el": "e-flexbox",
       "label": "Inner",
