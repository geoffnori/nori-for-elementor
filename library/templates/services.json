           },
           "classes": [
            "gap-m"
           ]
          },
          {
           "el": "e-flexbox",
           "label": "List",
           "children": [
            {
             "each": "items",
             "as": "item",
             "node": {
              "el": "e-grid",
              "label": "{item.title}",
              "children": [
               {
                "el": "e-paragraph",
                "text": "{item.title}",
                "classes": [
                 "type-h5"
                ],
                "css": {
                 "desktop": {
                  "color": "var(primary)",
                  "margin": "0px",
                  "letter-spacing": "-0.01em"
                 }
                }
               },
               {
                "el": "e-paragraph",
                "text": "{item.text}",
                "classes": [
                 "type-small"
                ],
                "css": {
                 "desktop": {
                  "color": "var(muted)",
                  "margin": "0px"
                 }
                }
               },
               {
                "el": "e-flexbox",
                "label": "Arrow",
                "children": [
                 {
                  "el": "e-svg",
                  "icon": "arrow-right",
                  "css": {
                   "desktop": {
                    "width": "18px",
                    "height": "18px",
                    "color": "var(primary)"
                   }
                  }
                 }
                ],
                "css": {
                 "desktop": {
                  "padding": "0px",
                  "flex-direction": "row",
                  "width": "44px",
                  "height": "44px",
                  "border-width": "1px",
                  "border-style": "solid",
                  "border-color": "var(line)",
                  "align-items": "center",
                  "justify-content": "center"
                 },
                 "mobile": {
                  "display": "none"
                 }
                },
                "classes": [
                 "border-radius-pill"
                ]
               }
              ],
              "css": {
               "desktop": {
                "padding": {
                 "block-start": "26px",
                 "block-end": "26px",
                 "inline-start": "0px",
                 "inline-end": "0px"
                },
                "grid-template-rows": "auto",
                "grid-template-columns": "minmax(0, 1fr) minmax(0, 1.3fr) auto",
                "align-items": "center"
               },
               "desktop:hover": {
                "padding": {
                 "block-start": "26px",
                 "block-end": "26px",
                 "inline-start": "10px",
                 "inline-end": "0px"
                }
               },
               "mobile": {
                "grid-template-columns": "minmax(0, 1fr)",
                "gap": "6px",
                "padding": {
                 "block-start": "20px",
                 "block-end": "20px",
                 "inline-start": "0px",
                 "inline-end": "0px"
                }
               }
              },
              "classes": [
               "border-bottom",
               "gap-m"
              ]
             }
            }
           ],
           "css": {
            "desktop": {
             "padding": "0px",
             "flex-direction": "column",
             "align-items": "stretch"
            }
           },
           "classes": [
            "border-top"
           ]
          }
         ],
         "css": {
          "desktop": {
           "padding": "0px",
           "grid-template-rows": "auto",
           "grid-template-columns": "minmax(0, 0.9fr) minmax(0, 1.3fr)",
           "align-items": "start"
          },
          "mobile": {
           "grid-template-columns": "minmax(0, 1fr)"
          }
         },
         "classes": [
          "gap-xl"
         ]
        }
       ],
       "css": {
        "desktop": {
         "padding": "0px",
         "flex-direction": "column",
         "align-items": "stretch"
        }
       },
       "classes": [
        "container-max-1200",
        "gap-l",
        "scroll-anim"
       ]
      }
     ],
     "css": {
      "desktop": {
       "flex-direction": "column",
       "background": "var(background)"
      }
     },
     "classes": [
      "section-gutter",
      "section-tb-padding-xl"
     ],
     "tag": "section"
    }
   ]
